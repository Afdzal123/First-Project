          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"pickup\": \"UTeM Library\",\n  \"destination\": \"Kolej Siswa\"\n}"
        },
        "url": {
          "raw": "http://localhost:5000/api/rides",
          "host": [
            "localhost"
          ],
          "port": "5000",
          "path": [
            "api",
            "rides"
          ]
        }
      }
    },
    {
      "name": "Driver - Accept Ride",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{driver_token}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": ""
        },
        "url": {
          "raw": "http://localhost:5000/api/rides/{{ride_id}}/accept",
          "host": [
            "localhost"
          ],
          "port": "5000",
          "path": [
            "api",
            "rides",
            "{{ride_id}}",
            "accept"
          ]
        }
      }
    },
